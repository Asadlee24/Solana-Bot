# ============================================================
# Low-Latency Solana Copy-Trading Bot Environment Configuration
# ============================================================

# Execution Mode: PAPER (default, zero capital risk) or LIVE
EXECUTION_MODE=PAPER

# Solana RPC & Helius Services
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
LASERSTREAM_GRPC_URL=grpc.helius-laserstream.com:443

# Execution Hot Wallet (Optional for PAPER mode, Required for LIVE mode)
# Provide Base58 encoded secret key or JSON byte array
FOLLOWER_PRIVATE_KEY=

# Target Wallets to watch (comma-separated list of Base58 Solana public keys)
WATCHED_WALLETS=CwUHN4zTn5wiEYoZjsP4FrDvAT9heDWewCTQjhgwhJqS

# Sizing Strategy
# Modes: FIXED_SIZE | TARGET_NOTIONAL_SCALAR | CAPPED_PROPORTIONAL_HYBRID
DEFAULT_SIZING_MODE=FIXED_SIZE
FIXED_BUY_SOL=0.1
COPY_RATIO=0.05
MAX_BUY_SOL=1.0

# Risk Engine & Safety Breakers
MAX_TOTAL_EXPOSURE_SOL=5.0
MIN_SOL_RESERVE_SOL=0.2
MAX_SIGNAL_AGE_MS=1500
MAX_ENTRY_GAP_BPS=200
MAX_SLIPPAGE_BPS=150
DAILY_LOSS_LIMIT_SOL=2.0
CONSECUTIVE_ERROR_LIMIT=5

# Web Server & API
API_PORT=3001
DASHBOARD_PORT=3000

# Telegram Alerts (Async worker off hot path)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database Storage Path (SQLite WAL Mode)
DB_PATH=./data/copy_bot.db

# Reown AppKit Project ID (Get free from https://cloud.reown.com)
VITE_REOWN_PROJECT_ID=
