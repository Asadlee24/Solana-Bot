# ============================================================
# Low-Latency Solana Copy-Trading Bot Environment Configuration
# ============================================================

# Execution Mode: LIVE (remains fail-closed DISARMED until explicit operator arm)
EXECUTION_MODE=LIVE
LIVE_REQUIRE_SIMULATION=true
MAINNET_SMOKE_TEST_MODE=true
SMOKE_TEST_ALLOWED_SIDE=BUY
SMOKE_TEST_FORCE_JUPITER=true
LIVE_TRADING_ACK=

# Solana RPC & Helius Services
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
LASERSTREAM_GRPC_URL=grpc.helius-laserstream.com:443

# Execution Hot Wallet (Dedicated smoke-test wallet only; do not use primary wallet)
# Provide Base58 encoded secret key or JSON byte array
FOLLOWER_PRIVATE_KEY=

# Target Wallets to watch (comma-separated list of Base58 Solana public keys)
WATCHED_WALLETS=CwUHN4zTn5wiEYoZjsP4FrDvAT9heDWewCTQjhgwhJqS

# Sizing Strategy: Single Controlled Smoke-Test Buy (0.01 SOL)
DEFAULT_SIZING_MODE=FIXED_SIZE
FIXED_BUY_SOL=0.01
COPY_RATIO=0.05
MAX_BUY_SOL=0.01

# Risk Engine & Safety Breakers (0.02 SOL Reserve Floor)
MAX_TOTAL_EXPOSURE_SOL=0.02
MIN_SOL_RESERVE_SOL=0.02
MAX_SIGNAL_AGE_MS=1500
MAX_ENTRY_GAP_BPS=200
MAX_SLIPPAGE_BPS=150
DAILY_LOSS_LIMIT_SOL=0.03
CONSECUTIVE_ERROR_LIMIT=5

# Web Server, Security & Dashboard
API_PORT=3001
DASHBOARD_PORT=3000
# Secret token required for mutating API actions (live arm, kill, manual sell/close, watched wallets, circuit reset)
# In production, missing token fails closed with 401. Generate with: openssl rand -hex 24
CONTROL_API_TOKEN=
# Explicit opt-in local development bypass (MUST BE FALSE in production; default: false)
ALLOW_UNAUTHENTICATED_CONTROL=false
# Secret token required to authenticate Helius incoming webhook requests (fails closed 503/401 if missing/invalid)
HELIUS_WEBHOOK_SECRET=
# Explicit opt-in local development webhook bypass (default: false)
ALLOW_UNAUTHENTICATED_WEBHOOK=false
# Comma-separated allowed CORS origins for browser dashboard (e.g. https://dashboard.mybot.com). Empty defaults to same-origin / localhost in dev.
CORS_ALLOWED_ORIGINS=

# Telegram Alerts & Interactive Control
TELEGRAM_BOT_TOKEN=
# Authorized Telegram Chat ID (comma-separated if multiple). If unset, use TELEGRAM_PAIRING_CODE to pair via /pair <code>
TELEGRAM_CHAT_ID=
# One-time setup pairing code for /pair <setup_code> command. Single-use, stored securely in SQLite.
TELEGRAM_PAIRING_CODE=

# Database Storage Path (SQLite WAL Mode)
DB_PATH=./data/copy_bot.db

# Reown AppKit Project ID (Get free from https://cloud.reown.com)
VITE_REOWN_PROJECT_ID=
