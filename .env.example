# ==============================================================================
# Low-Latency Solana Copy-Trading Bot Environment Configuration
# ==============================================================================
# Default installation is PAPER mode and DISARMED for safety.
# Before running live, review docs/RELEASE_CHECKLIST.md carefully.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Execution & Environment Mode
# ------------------------------------------------------------------------------
# Allowed: PAPER (simulation) | LIVE (real mainnet trading)
# Default: PAPER
EXECUTION_MODE=PAPER

# Mandatory acknowledgement string required to arm in LIVE mode.
# If EXECUTION_MODE=LIVE, this MUST match exactly:
LIVE_TRADING_ACK=

# Safety guards for live execution
LIVE_REQUIRE_SIMULATION=true
MAINNET_SMOKE_TEST_MODE=true
SMOKE_TEST_ALLOWED_SIDE=BUY
SMOKE_TEST_FORCE_JUPITER=true

# ------------------------------------------------------------------------------
# 2. Solana RPC & Helius Services
# ------------------------------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here
LASERSTREAM_GRPC_URL=grpc.helius-laserstream.com:443

# Optional fallback fixed SOL/USD price if offline
# SOL_PRICE_USD=140.0

# ------------------------------------------------------------------------------
# 3. Execution Hot Wallet (LIVE mode only)
# ------------------------------------------------------------------------------
# Dedicated burner/smoke-test wallet only; NEVER use your primary cold wallet.
# Provide Base58-encoded private key OR JSON byte array: [12,34,56,...]
FOLLOWER_PRIVATE_KEY=

# Initial capital baseline (SOL) used for tracking percentage ROI
LIVE_INITIAL_BALANCE_SOL=0.2610

# ------------------------------------------------------------------------------
# 4. Target Wallets to Copy
# ------------------------------------------------------------------------------
# Comma-separated list of Base58 Solana public keys to watch
WATCHED_WALLETS=CwUHN4zTn5wiEYoZjsP4FrDvAT9heDWewCTQjhgwhJqS

# ------------------------------------------------------------------------------
# 5. Sizing Strategy & Sizing Bounds
# ------------------------------------------------------------------------------
# Sizing mode: FIXED_SIZE | TARGET_NOTIONAL_SCALAR | CAPPED_PROPORTIONAL_HYBRID
DEFAULT_SIZING_MODE=FIXED_SIZE

# Sizing parameters (in SOL)
FIXED_BUY_SOL=0.01
COPY_RATIO=0.05
MAX_BUY_SOL=0.01

# ------------------------------------------------------------------------------
# 6. Risk Engine, Pre-Trade Controls & Circuit Breakers
# ------------------------------------------------------------------------------
# Maximum cumulative exposure across all open positions (SOL)
MAX_TOTAL_EXPOSURE_SOL=0.02

# Hard reserve floor reserved exclusively for rent and fees (SOL)
MIN_SOL_RESERVE_SOL=0.02

# Maximum age of signal (in ms) before dropping as stale
MAX_SIGNAL_AGE_MS=1500

# Maximum allowed entry price gap vs target trader in basis points (200 bps = 2.0%)
MAX_ENTRY_GAP_BPS=200

# Maximum allowed buy AMM slippage in basis points (200 bps = 2.0%)
MAX_SLIPPAGE_BPS=200

# Maximum emergency sell slippage in basis points (1500 bps = 15.0%)
MAX_SELL_SLIPPAGE_BPS=1500

# Daily loss limit in SOL; trips circuit breaker if hit
DAILY_LOSS_LIMIT_SOL=0.03

# Number of consecutive failures before tripping circuit breaker
CONSECUTIVE_ERROR_LIMIT=5

# Lifetime 1-entry per coin guard (blocks re-buying previously traded tokens)
NEVER_REBUY_SAME_TOKEN=true
SINGLE_ENTRY_PER_TOKEN_ENABLED=true
TOKEN_BUY_COOLDOWN_SEC=300

# ------------------------------------------------------------------------------
# 7. Automated Exit Engine (Moonbag & Breakeven Protection)
# ------------------------------------------------------------------------------
# Take-profit trigger (+100% = 2x gain) and sell fraction (50% sold)
AUTO_TP_ENABLED=true
AUTO_TP_GAIN_PCT=100
AUTO_TP_SELL_FRACTION=0.5

# Anti-rug emergency stop-loss floor (-30% drop cuts 100%)
AUTO_SL_ENABLED=true
AUTO_SL_LOSS_PCT=30

# High-frequency exit check interval (ms)
AUTO_EXIT_POLL_INTERVAL_MS=800

# Breakeven floor & dynamic trailing stop-loss
TRAILING_SL_ENABLED=true
BREAKEVEN_TRIGGER_PCT=20
BREAKEVEN_LOCK_PCT=2
TRAILING_SL_CUSHION_PCT=15

# ------------------------------------------------------------------------------
# 8. Web Server, API Security & CORS
# ------------------------------------------------------------------------------
API_PORT=3001
DASHBOARD_PORT=3000

# Secret token required for mutating API actions (live arm, kill, sell, wallets, reset)
# Generate with: openssl rand -hex 24
CONTROL_API_TOKEN=

# Explicit opt-in local development bypass (MUST BE false IN PRODUCTION)
ALLOW_UNAUTHENTICATED_CONTROL=false

# Secret token required to authenticate Helius webhook payloads (Bearer / x-api-key)
HELIUS_WEBHOOK_SECRET=

# Explicit development webhook bypass (MUST BE false IN PRODUCTION)
ALLOW_UNAUTHENTICATED_WEBHOOK=false

# Allowed CORS origins for dashboard API (comma-separated, e.g. https://mybot.com)
# Empty defaults to same-origin / localhost in development
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 9. Telegram Operator Interface & Alerts
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# Authorized chat ID(s) comma-separated. Leave empty to use /pair setup code
TELEGRAM_CHAT_ID=

# One-time secret pairing code for operator chat authorization (/pair <code_here>)
TELEGRAM_PAIRING_CODE=

# ------------------------------------------------------------------------------
# 10. Database & Storage Configuration
# ------------------------------------------------------------------------------
# SQLite database path (WAL mode enabled automatically)
DB_PATH=./data/copy_bot.db

# ------------------------------------------------------------------------------
# 11. Frontend Dashboard Reown AppKit Project ID
# ------------------------------------------------------------------------------
# Free project ID from https://cloud.reown.com for browser wallet read-only view
VITE_REOWN_PROJECT_ID=
